site/

# Environment files — gitignore .env and variants, but NOT .env.example
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# GRIB scratch files (never persist in git)
*.grib
*.grib2
*.idx

# Snapshot dev volume (Docker-managed)
snapshots/

# Type stub caches
.mypy_cache/
.pyright/
pyrightconfig.json
