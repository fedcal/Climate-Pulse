# Climate Pulse — environment variable template
# Copy this file to .env and adjust values for your environment.
# IMPORTANT: Never commit .env — it is gitignored.
# This file contains only placeholder values (no real secrets).

# PostgreSQL / TimescaleDB
POSTGRES_DB=climatepulse
POSTGRES_USER=climatepulse
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://climatepulse:changeme@timescale:5432/climatepulse

# Redis
REDIS_URL=redis://redis:6379

# Snapshot storage (Docker volume mount path)
# Default: /var/lib/climatepulse/snapshots
SNAPSHOT_DIR=/var/lib/climatepulse/snapshots

# Application
LOG_LEVEL=INFO
ENVIRONMENT=development
